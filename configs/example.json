    "zcode": "FILL IN DURING SMOKE TEST"
  },
  "prices_per_million": {
    "claude-sonnet-5-5": {"input_tokens": 2.0, "output_tokens": 10.0, "cached_tokens": 0.10},
    "gpt-6.1-sol": {"input_tokens": 2.0, "output_tokens": 10.0, "cached_tokens": 0.0},
    "glm-5.3-flash": {"input_tokens": 0.15, "output_tokens": 0.50, "cached_tokens": 0.0}
